{
  "name": "axon-coach-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:isolation && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:workout-runtime:security": "vitest run tests/unit/workout-agent-policy.test.ts tests/unit/workout-runtime.test.ts tests/unit/workout-run-repository-contract.test.ts && vitest run --config vitest.integration.config.mts tests/integration/workout-run-stream.test.ts",
    "test:workout-runtime:integrity": "vitest run tests/unit/workout-composition.test.ts tests/unit/workout-provenance.test.ts tests/unit/workout-runtime.test.ts tests/unit/workout-run-repository-contract.test.ts tests/unit/workout-run-worker.test.ts && vitest run --config vitest.integration.config.mts tests/integration/workout-run-stream.test.ts",
    "eval:workout-runtime": "tsx tests/fixtures/workout-generation-scenarios.ts",
    "worker:workout-run": "tsx scripts/run-workout-worker.ts",
    "demo": "tsx scripts/run-connected-demo.ts",
    "graph:seed": "tsx scripts/seed-movement-graph.ts seed",
    "graph:inspect": "tsx scripts/seed-movement-graph.ts inspect",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "graph:seed:member": "tsx scripts/seed-member-context.ts",
    "check:isolation": "node scripts/check-production-isolation.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "ai": "7.0.55",
    "neo4j-driver": "6.2.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3",
    "tsx": "4.23.8",
    "vitest": "4.1.10"
  }
}
