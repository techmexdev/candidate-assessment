# Local deterministic connected demo (no provider credential required)
NODE_ENV=development
WORKOUT_ROUTE_SECRET=replace-with-at-least-32-local-placeholder-bytes
WORKOUT_WORKER_ID=worker:connected-demo
WORKOUT_DEMO_MODE=deterministic
WORKOUT_WORKER_POLL_MS=1000

# Neo4j defaults match compose.yaml; replace only for a non-default instance.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-local-placeholder
NEO4J_DATABASE=neo4j

# Optional provider mode (never commit a real key).
# WORKOUT_DEMO_MODE=provider
# AI_GATEWAY_API_KEY=replace-with-provider-key
# WORKOUT_MODEL_ID=replace-with-gateway-model-id
# COPILOT_MODEL_ID=replace-with-gateway-model-id
