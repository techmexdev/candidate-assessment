# Copy this file to .env. Project scripts load the root .env automatically.
# Never commit .env or real credentials.

# Local deterministic connected demo (no provider credential required)
NODE_ENV=development
WORKOUT_ROUTE_SECRET=replace-with-at-least-32-local-placeholder-bytes
WORKOUT_WORKER_ID=worker:connected-demo
WORKOUT_DEMO_MODE=deterministic
WORKOUT_WORKER_POLL_MS=1000

# Neo4j defaults match compose.yaml; replace only for a non-default instance.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=movement-graph-local-test
NEO4J_DATABASE=neo4j

# Optional provider mode. Direct OpenAI is selected automatically when
# OPENAI_API_KEY is present, or set AI_PROVIDER=openai explicitly.
# WORKOUT_DEMO_MODE=provider
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-openai-key
# WORKOUT_MODEL_ID=gpt-4o-mini
# COPILOT_MODEL_ID=gpt-4o-mini

# Optional Vercel AI Gateway mode (use AI_PROVIDER=gateway explicitly).
# AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=replace-with-gateway-key
# WORKOUT_MODEL_ID=openai/gpt-4.1-mini
# COPILOT_MODEL_ID=openai/gpt-4.1-mini

# Railway minimum demo (configure in Railway, not in a committed local .env).
# NODE_ENV=production
# AXON_RUNTIME_PROFILE=railway-demo
# NEO4J_ALLOW_INSECURE_RAILWAY=1
# NEO4J_PRIVATE_DOMAIN=${{neo4j.RAILWAY_PRIVATE_DOMAIN}}
# NEO4J_URI=bolt://${{NEO4J_PRIVATE_DOMAIN}}:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=generate-a-real-private-demo-password
# NEO4J_DATABASE=neo4j
# WORKOUT_DEMO_MODE=deterministic
# WORKOUT_WORKER_ID=worker:railway-demo
# WORKOUT_ROUTE_SECRET=generate-a-32-byte-secret
# COPILOT_SESSION_SECRET=${{WORKOUT_ROUTE_SECRET}}
# COPILOT_CONTINUATION_SECRET=generate-a-different-32-byte-secret
